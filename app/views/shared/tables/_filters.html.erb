<%= form_with url: url, method: :get, class: "table-filters", aria: { controls: frame },
      data: { controller: "table-filters", turbo_frame: frame, turbo_action: "advance" } do |form| %>
  <div class="filter-field filter-field--search">
    <%= form.label :query, "Search hosts" %>
    <%= form.search_field :query, value: params[:query], placeholder: "Hostname, IP, vendor…",
          autocomplete: "off", data: { action: "input->table-filters#submit" } %>
  </div>

  <% filters.each do |filter| %>
    <div class="filter-field">
      <%= form.label filter[:key], filter[:label] %>
      <%= form.select filter[:key], options_for_select(filter[:options], params[filter[:key]]),
            { include_blank: "All #{filter[:label].downcase}" },
            data: { action: "change->table-filters#submitNow" } %>
    </div>
  <% end %>

  <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>
  <%= hidden_field_tag :direction, params[:direction] if params[:direction].present? %>

  <div class="filter-actions">
    <%= form.submit "Apply", class: "button button--secondary" %>
    <%= link_to "Clear", url,
          data: { turbo_frame: frame, turbo_action: "advance", action: "table-filters#clear" },
          class: "text-link" %>
  </div>
<% end %>
