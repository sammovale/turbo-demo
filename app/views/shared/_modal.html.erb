<dialog class="modal" aria-labelledby="modal-title" data-turbo-temporary data-controller="modal"
  data-action="click->modal#closeOnBackdrop cancel->modal#close">
  <div class="modal__panel">
    <header class="modal__header">
      <div>
        <p class="eyebrow"><%= local_assigns.fetch(:eyebrow, "Quick edit") %></p>
        <h2 id="modal-title"><%= title %></h2>
      </div>
      <button type="button" class="modal__close" aria-label="Close" data-action="modal#close">×</button>
    </header>

    <div class="modal__body">
      <%= yield %>
    </div>
  </div>
</dialog>
