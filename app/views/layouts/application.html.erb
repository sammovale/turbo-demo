<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Netdeck" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Netdeck">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand__mark">N</span>
          <span>Netdeck</span>
        <% end %>

        <nav aria-label="Main navigation">
          <%= link_to "Network hosts", network_hosts_path, class: "nav-link" %>
        </nav>
      </div>
    </header>

    <section id="toasts" class="toasts" aria-live="polite" aria-atomic="false">
      <% flash.each do |type, message| %>
        <%= render "shared/toast", message: message, type: type if message.present? %>
      <% end %>
    </section>

    <main class="shell">
      <%= yield %>
    </main>

    <%= turbo_frame_tag "modal" %>
  </body>
</html>
